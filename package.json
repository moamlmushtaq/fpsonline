{
  "name": "halcyon-front",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HALCYON FRONT — a retro-futurist online multiplayer first-person shooter for the browser.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts --dev",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "preview": "npm run build && npm start",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/space-grotesk": "^5.1.0",
    "@types/node": "^22.10.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.0",
    "playwright": "1.56.1",
    "three": "^0.180.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
